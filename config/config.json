{
  "machine_id": "Smart40-N2",
  "machine_name": "Célula Smart 4.0 Modular",
  "opcua": {
    "endpoint": "opc.tcp://192.168.0.20:4840",
    "enabled": false
  },
  "storage": {
    "data_dir": "data",
    "telemetry_file_prefix": "telemetria",
    "current_state_file": "estado_atual.json",
    "alerts_file": "alertas.json",
    "metrics_file": "indicadores.json",
    "invalid_file": "leituras_invalidas.csv",
    "notification_control_file": "notificacoes_enviadas.json"
  },
  "variables": {
    "temperature": {
      "node_id": "ns=3;s=Machine.Temperature",
      "unit": "°C",
      "min": 0,
      "max": 250,
      "warning_high": 220,
      "critical_high": 240
    },
    "pressure": {
      "node_id": "ns=3;s=Machine.Pressure",
      "unit": "bar",
      "min": 0,
      "max": 300,
      "warning_low": 40,
      "critical_low": 25
    },
    "cycle_time": {
      "node_id": "ns=3;s=Production.CycleTime",
      "unit": "s",
      "min": 0,
      "max": 3600,
      "warning_high": 30
    },
    "piece_counter": {
      "node_id": "ns=3;s=Production.PieceCounter",
      "unit": "peças",
      "min": 0,
      "max": 100000000
    },
    "machine_status": {
      "node_id": "ns=3;s=Machine.Status",
      "unit": "código",
      "min": 0,
      "max": 10
    },
    "power_consumption": {
      "node_id": "ns=3;s=Energy.PowerConsumption",
      "unit": "kW",
      "min": 0,
      "max": 50,
      "warning_high": 12,
      "critical_high": 20
    },
    "motor_vibration": {
      "node_id": "ns=3;s=Machine.MotorVibration",
      "unit": "mm/s",
      "min": 0,
      "max": 20,
      "warning_high": 4.5,
      "critical_high": 7
    },
    "motor_temperature": {
      "node_id": "ns=3;s=Machine.MotorTemperature",
      "unit": "°C",
      "min": 0,
      "max": 180,
      "warning_high": 90,
      "critical_high": 120
    },
    "rejected_parts": {
      "node_id": "ns=3;s=Production.RejectedParts",
      "unit": "peças",
      "min": 0,
      "max": 100000000
    }
  }
}
